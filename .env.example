# Leave empty for the fully offline deterministic workflow.
# Install Ollama and pull a local model before filling these values.
LLM_BASE_URL=
LLM_MODEL=
# Example base: http://127.0.0.1:11434/v1
# Model: use an exact locally installed tag reported by `ollama list`.
# Cloud hosts are deliberately blocked. No API key is needed.

# Optional: absolute local directory of a sentence-transformers model.
# Download it separately before running; requests never download models.
EMBEDDING_MODEL_PATH=
# R2J_DB_PATH=runtime/resume2job.db
